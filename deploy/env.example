# ~/.config/handl-ci/env — copy to ~/.config/handl-ci/env and fill in.

# Required
HL_WEBHOOK_SECRET=          # shared secret; also given to the webhook config
HANDL_TOKEN=                # GitHub PAT: private dep fetch + commit statuses

# Pipeline tuning
CI_REPO_DIR=                # platform clone to fetch/worktree from (default: cwd)
CI_BRANCH=refs/heads/main
CI_SHARDS=1                 # nextest partitions — the suite is memory-bound
CI_JOBS=2
CI_DOGFOOD_JOBS=0
CI_CANCEL_RUNNING=0         # 1 = kill in-flight run when a newer push lands

# Listener + tunnel
CI_LISTEN=127.0.0.1:9000    # local bind; tunnel terminates TLS outside
TUNNEL_PROVIDER=cloudflared
TUNNEL_NAME=handl-ci          # named tunnel: stable URL via ~/.cloudflared/config.yml
TUNNEL_PUBLIC_URL=https://ci.luisfuturist.com # deploy/tunnel.d/<provider>.sh
# TUNNEL_PUBLIC_URL=        # provider=direct only
# TUNNEL_LOCAL_URL=         # provider override, default http://127.0.0.1:9000
