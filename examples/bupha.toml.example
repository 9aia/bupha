# bupha.toml — one per watched repo. Secrets resolve via env var ->
# OS keyring (secret-tool) -> ~/.config/bupha/env; never this file.

# Watched repos — one pending slot each, one shared worker.
# `name` must match the payload's repository.full_name.
[[repo]]
name = "owner/name"
dir = "/path/to/clone"
branch = "refs/heads/main"
# queue = "all"                  # run every push FIFO (default: latest-wins)
# status_repo = "owner/name"     # optional override for statuses
# secret_env = "REPO_WEBHOOK_SECRET"  # per-repo hook secret (default:
                                  # trigger.secret_env) — lets each repo's
                                  # hook be managed independently
# [repo.runner]                # optional per-repo runner override
#   kind = "shell"             #   (full replacement of [runner])
#   cmd = "./scripts/release.sh"

# Multiple pipelines for one repo — each [[repo.jobs]] gets its own
# branch, queue, runner and status context ("ci/bupha/<job>" by
# default); they share the repo's webhook, secret and clone. When
# [[repo.jobs]] is present the repo-level branch/queue/runner only
# act as the jobs' defaults.
# [[repo.jobs]]
# name = "gate"                  # path-safe [A-Za-z0-9._-]+; lands in
#                                # worktree names + status contexts
# branch = "refs/heads/main"
# queue = "latest"
# [repo.jobs.runner]
#   kind = "shell"
#   cmd = "bash scripts/ci.sh"
# [[repo.jobs]]
# name = "docs"
# branch = "refs/heads/docs"
# context = "ci/docs"            # status context override
# [repo.jobs.runner]
#   kind = "shell"
#   cmd = "bash scripts/deploy-docs.sh"

[trigger]
kind = "github"                   # impl: bupha-github
listen = "127.0.0.1:29173"
secret_env = "BUPHA_WEBHOOK_SECRET"

[runner]
kind = "dagger"                   # impl: bupha-runner-dagger
# kind = "shell"                 # impl: bupha-runner-script (no containers)
# cmd = "./ci.sh"                 # shell runner only
function = "ci"
shards = "1"
jobs = "2"
# Extra dagger flags are emitted only when set — the module's function
# must declare every flag the runner sends (`dagger call` rejects
# unknown args). shards/jobs/token are always sent; these are opt-in:
# dogfood_jobs = "2"              # only if your ci() accepts it
# sequential = true               # memory-constrained boxes
cancel_running = true             # kill in-flight run on newer push
                                  # (invalid with queue = "all")
sccache_conf = "/path/to/sccache-env"   # optional KEY=VAL secret file
token_env = "BUPHA_TOKEN"
# extra_args = ["--flag", "val"]  # appended verbatim to dagger call
# cli_source = "/path/to/sibling-checkout"   # emitted as --cli-source
                                     # if your ci() declares it

[status]
kind = "github"                   # impl: bupha-github | "log" | "none"
# repo = "owner/name"             # only for legacy configs;
                                  # [[repo]] posts to status_repo (defaults to name)
context = "ci/bupha"

[tunnel]
provider = "none"                 # none | cloudflared | direct
# provider = "cloudflared"        # prefer a NAMED tunnel — quick
# name = "my-tunnel"              #   (*.trycloudflare.com) URLs are
#                                 #   flaky at the Cloudflare edge
# local_url = "http://127.0.0.1:29173"
# public_url = "https://ci.example.com"  # needed for deploy webhook

[worktree]
base = "/tmp/bupha"               # worktrees land at <base>-<repo>-<sha12>
