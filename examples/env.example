# ~/.config/bupha/env (chmod 600) — secrets only; everything
# else is in bupha.toml. This file is the dev-mode / no-cuora
# fallback — the canonical store is cuora:
#   printf '%s' "$VALUE" | cuora put cuora://bupha/<NAME>
BUPHA_WEBHOOK_SECRET=
BUPHA_TOKEN=                  # repo-scoped PAT: statuses + webhook admin
# No CARGO_REGISTRY_TOKEN — ADR-0004: crates.io publishing is
# tamias-only; bupha's tarsi.toml has [publish.crates] enabled = false.
