# ~/.config/bupha/env (chmod 600) — secrets only; everything
# else is in bupha.toml. Alternatively store them in your OS
# keyring: secret-tool store --label='bupha: NAME' service bupha name NAME
BUPHA_WEBHOOK_SECRET=
BUPHA_TOKEN=                  # repo-scoped PAT: statuses + webhook admin
# CARGO_REGISTRY_TOKEN=       # only if a repo uses scripts/release.sh
