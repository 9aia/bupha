{
  "name": "bupha-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "bun run docs:gen && vitepress dev",
    "docs:gen": "bun run docs:cli && bun run docs:config && bun run docs:crates",
    "docs:check": "bun run docs:gen && git diff --exit-code",
    "docs:cli": "cypera gen cli --repo ..",
    "docs:config": "cypera gen config --repo ..",
    "docs:crates": "cypera gen crate-map --repo ..",
    "docs:build": "bun run docs:gen && vitepress build",
    "docs:api": "cypera gen api --repo ..",
    "docs:deploy": "bun run docs:api && bun run docs:build && bunx gh-pages -d .vitepress/dist",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "check": "vp check"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite-plus": "^1.3.0",
    "vitepress": "^1.6.3",
    "vitepress-plugin-llms": "^1.14.0",
    "vitepress-theme-9aia": "github:9aia/vitepress-theme-9aia#5e07954bb6db86ede9fccabdbdb2aa8681d1053e"
  }
}
